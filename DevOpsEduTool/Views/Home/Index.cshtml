@{
    ViewData["Title"] = "DevOps Learning Hub";
}

        <section class="dashboard">
            <h2>Your learning progress</h2>
            <div class="progress-bar-container">
                <script src="~/js/progress.js"></script>
                <div class="progress-bar"></div>
            </div>
            <p id="progress-text">Loading progress...</p>
        </section>

        <section class="modules">
            <h2>Available Modules</h2>
            <div class="module-grid">
                @foreach (var module in Model)
    {
                <article class="module-card @(module.IsLocked ? "locked" : "in-progress")">
                    <h3>@module.Name</h3>
                    <p>@module.Description</p>
                    @if (!module.IsLocked)
            {
                    <a asp-controller="Modules" asp-action="@module.ControllerAction" class="btn">Start Module</a>
            }
            else
            {
                    <span class="status-badge">Locked</span>
            }
                </article>
    }
