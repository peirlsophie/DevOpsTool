@{
    ViewData["Title"] = "DevOps Learning Hub";
}

        <section class="dashboard">
            <h2>Your learning progress</h2>
            <div class="progress-bar-container">
                <script src="~/js/progress.js"></script>
                <div class="progress-bar"></div>
            </div>
            <p id="progress-text">Loading progress...</p>
        </section>

        <section class="modules">
            <h2>Available Modules</h2>
            <div class="module-grid">
                @foreach (var module in Model)
                {
                var initialClass = (module.Id == 1) ? "in-progress" : "locked";
                var initialStatus = (module.Id == 1) ? "Available" : "Locked";
                   <article id="card-@module.ControllerAction.ToLower()" class="module-card @initialClass">
                       <h3>@module.Name</h3>
                       <p>@module.Description</p>

                       <span id="status-@module.ControllerAction.ToLower()" class="status-badge">@initialStatus</span>

                       <a asp-controller="Modules" asp-action="@module.ControllerAction"
                          class="btn" id="btn-@module.ControllerAction.ToLower()">Start Module</a>
                   </article>
                }
            </div>
        </section>
