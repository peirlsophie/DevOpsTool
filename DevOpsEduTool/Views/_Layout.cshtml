<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/module-style.css" />
</head>
<body>
    <header>
        <nav>
            <div class="logo">DevOps Academy</div>
            <div class="user-profile">
                @if (User.Identity.IsAuthenticated) {
                <span>Logged in as: <strong>@User.Identity?.Name</strong></span>
                <form asp-controller="Account" asp-action="Logout" method="post" onclick="localStorage.clear()" style="display:inline">
                    <button type="submit" class="btn-secondary" >Logout</button>
                </form>
        } else {
                <button class="btn" onclick="openLogin()">Login</button>
                <a asp-controller="Account" asp-action="Register" class="btn-secondary">Register</a>
        }
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="index-footer">
        <div>
            <button class="btn-secondary" onclick="resetEverything()">Reset Progress</button>
        </div>
    </footer>

    <script src="~/js/progress.js"></script>
    <script src="~/js/login.js"></script>
    <div id="loginModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeLogin()">&times;</span>
            <h2>Login</h2>
            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="text" name="username" placeholder="Username" required />
                <input type="password" name="password" placeholder="Password" required />
                <button type="submit" class="btn">Login</button>
            </form>
            <p>Not registered yet? <a asp-controller="Account" asp-action="Register">Create an account here</a></p>
        </div>
    </div>
</body>
</html>