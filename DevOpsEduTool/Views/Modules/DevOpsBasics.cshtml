@{
    ViewData["Title"] = "DevOpsBasics";
}

<body>
    <header>
        <nav>
            <div class="logo">
                <a asp-controller="Home" asp-action="Index"
                   style="text-decoration: none; color: inherit">&#8592; Back to the Dashboard</a>
            </div>
            <div class="module-title">Module 1: DevOps Fundamentals</div>
        </nav>
    </header>

    <main class="module-container">
        <div id="step-1" class="step">
            <section class="learning-section">
                <span class="step-label">Part 1: Theory</span>
                <h2>What is DevOps?</h2>
                <div class="content">
                    <p>
                        DevOps bridges the gap between development and operations by promoting a culture of collaboration, shared responsibilities, and continuous feedback using automation throughout the software development life cycle.
                    </p>
                    </p>
                    Fundamental ideas of DevOps:
                    <ul>
                        <li>Continous Integration: The practice of frequently merging code changes into a shared repository, to ensure real-time feedback and code quality.</li>
                        <li>Continous Delivery: Changes are built into packages and tested automatically. Aims to ready the latest artifacts for deployment.</li>
                        <li>Communication and collaboration: Promoting effective teamwork, Knowledge sharing and streamlined workflows. </li>
                    </ul>
                    </p>
                    <p>
                        xyz
                    </p>
                    <div class="info-box"><strong>Remember: </strong> Info</div>
                    <button class="btn" onclick="nextStep(2)">Next: Knowledge Check</button>
                </div>
            </section>
        </div>

        <div id="step-2" class="step" style="display: none;">
            <section class="learning-section">
                <div class="quiz-box">
                    <h4>Knowledge check</h4>
                    <p>What is a Container?</p>
                    <script src="~/js/task.js"></script>
                    <form id="quiz-1">
                        <label><input type="radio" name="q1" value="a" /> A single, portable unit used to package an application with all its dependencies (libraries, configuration files, runtime)</label><br />
                        <label><input type="radio" name="q1" value="b" /> An open-source platform that automates deploying, scaling, and managing containerized applications.</label><br />
                        <button type="button" class="btn-check" onclick="checkQuiz()">
                            Check answer
                        </button>
                    </form>
                    <div id="feedback-quiz-1" class="quiz-feedback"></div>
                    <div class="navigation-btns">
                        <button class="btn-secondary" onclick="nextStep(1)">Back</button>
                        <button class="btn" onclick="nextStep(3)">Next: Docker Architecture</button>
                    </div>
                </div>
            </section>
        </div>

        <div id="step-3" class="step" style="display: none;">
            <section class="learning-section">
                <h2>What is Docker?</h2>
                <div class="content">
                    <p>
                        DevOps bridges the gap between development and operations by promoting a culture of collaboration, shared responsibilities, and continuous feedback using automation throughout the software development life cycle.
                    </p>
                    <p>
                        Fundamental ideas of DevOps:
                        <ol>
                            <li>Continous Integration: </li>
                            <li>Continous Delivery: </li>
                            <li>infrastructure as Code:</li>
                        </ol>
                        The Workflow:
                        <ul>
                            <li>You type docker build -> Client sends request to Daemon -> Daemon creates an Image.</li>
                            <li>You type docker run -> Client sends request to Daemon -> Daemon launches a Container.</li>
                        </ul>
                    </p>
                    <div class="navigation-btns">
                        <button class="btn-secondary" onclick="nextStep(2)">Back</button>
                        <button class="btn" onclick="nextStep(4)">Next: Knowledge Check</button>
                    </div>
                </div>
            </section>
        </div>

        <div id="step-4" class="step" style="display: none;">
            <section class="learning-section">
                <div class="quiz-box">
                    <h4>Knowledge check</h4>
                    <p>What is Docker?</p>
                    <form id="quiz-2">
                        <label><input type="radio" name="q1" value="a" /> The most widely used platform for creating and managing containers</label><br />
                        <label><input type="radio" name="q1" value="b" /> A package manager for Kubernetes that simplifies deployment and management of applications on Kubernetes clusters.</label><br />
                        <button type="button" class="btn-check" onclick="checkQuiz()">
                            Check answer
                        </button>
                    </form>
                    <div id="feedback-quiz-2" class="quiz-feedback"></div>
                    <div class="navigation-btns">
                        <button class="btn-secondary" onclick="nextStep(3)">Back</button>
                        <button class="btn" onclick="nextStep(5)">Next: Practical Lab</button>
                    </div>
                </div>
            </section>
        </div>

        <div id="step-5" class="step" style="display:none;">
            <section class="learning-section">
                <span class="step-label">Part 2: Practice</span>
                <h2>XYZ</h2>
                <p>xyz</p>

                <div class="code-block">
                    <code>xyz</code>
                    <button class="copy-btn">Copy</button>
                </div>

                <div class="exercise-instruction">
                    <h4>Exercise:</h4>
                    <p>xyz</p>
                    <input type="text" placeholder="placeholder..." />
                </div>
                <div class="navigation-btns">
                    <button class="btn-secondary" onclick="nextStep(4)">Back</button>
                    <button class="btn-primary" onclick="completeModule('module_devopsBasics')">
                        Complete Module
                    </button>
                </div>
            </section>
        </div>

        <footer class="module-footer">
            <script src="~/js/task.js"></script>
            <script src="~/js/progress.js"></script>
        </footer>
    </main>
</body>